                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "module-level script (python block in codex-rewrite-directions.md)",
                  "fullyQualifiedName": "module-level script (python block in codex-rewrite-directions.md)"
                }
              ]
            }
          ],
          "properties": {
